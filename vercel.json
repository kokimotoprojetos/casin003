{
  "version": 2,
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-php@0.7.1",
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "^/api/frontend/(.*)",
      "dest": "/api/v1/api.php"
    },
    {
      "src": "^/assets/(.*)",
      "dest": "/assets/$1",
      "continue": true
    },
    {
      "src": "^/uploads/(.*)",
      "dest": "/uploads/$1",
      "continue": true
    },
    {
      "src": "^/storage/(.*)",
      "dest": "/storage/$1",
      "continue": true
    },
    {
      "src": "^/images/(.*)",
      "dest": "/images/$1",
      "continue": true
    },
    {
      "src": "^/imgs/(.*)",
      "dest": "/imgs/$1",
      "continue": true
    },
    {
      "src": "^/img/(.*)",
      "dest": "/img/$1",
      "continue": true
    },
    {
      "src": "^/svg/(.*)",
      "dest": "/svg/$1",
      "continue": true
    },
    {
      "src": "^/icons/(.*)",
      "dest": "/icons/$1",
      "continue": true
    },
    {
      "src": "^/gif/(.*)",
      "dest": "/gif/$1",
      "continue": true
    },
    {
      "src": "^/image/(.*)",
      "dest": "/image/$1",
      "continue": true
    },
    {
      "src": "^/theme/(.*)",
      "dest": "/theme/$1",
      "continue": true
    },
    {
      "src": "^/themes/(.*)",
      "dest": "/themes/$1",
      "continue": true
    },
    {
      "src": "^/sw/(.*)",
      "dest": "/sw/$1",
      "continue": true
    },
    {
      "src": "^/dash/assets/(.*)",
      "dest": "/dash/assets/$1",
      "continue": true
    },
    {
      "src": "^/admin/assets/(.*)",
      "dest": "/admin/assets/$1",
      "continue": true
    },
    {
      "src": "^/src/components/(.*)",
      "dest": "/src/components/$1",
      "continue": true
    },
    {
      "src": "^/sw\\.produce\\.min\\.2\\.1\\.6\\.js$",
      "dest": "/sw.produce.min.2.1.6.js",
      "continue": true
    },
    {
      "src": "^/version\\.js$",
      "dest": "/version.js",
      "continue": true
    },
    {
      "src": "^/favicon\\.ico$",
      "dest": "/favicon.ico",
      "continue": true
    },
    {
      "src": "^/favicon\\.png$",
      "dest": "/favicon.png",
      "continue": true
    },
    {
      "src": "^/logo\\.png\\.webp$",
      "dest": "/logo.png.webp",
      "continue": true
    },
    {
      "src": "^/versionControl/(.*)",
      "dest": "/versionControl/$1",
      "continue": true
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
