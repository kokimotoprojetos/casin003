{
  "version": 2,
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.4",
      "maxDuration": 60,
      "excludeFiles": "{uploads/**,igamewin/**,assets/**,images/**,img/**,imgs/**,svg/**,icons/**,gif/**,theme/**,themes/**,sw/**,versionControl/**,node_modules/**}"
    }
  },
  "routes": [
    {
      "src": "^/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "^/uploads/(.*)",
      "dest": "/uploads/$1"
    },
    {
      "src": "^/images/(.*)",
      "dest": "/images/$1"
    },
    {
      "src": "^/img/(.*)",
      "dest": "/img/$1"
    },
    {
      "src": "^/imgs/(.*)",
      "dest": "/imgs/$1"
    },
    {
      "src": "^/svg/(.*)",
      "dest": "/svg/$1"
    },
    {
      "src": "^/icons/(.*)",
      "dest": "/icons/$1"
    },
    {
      "src": "^/gif/(.*)",
      "dest": "/gif/$1"
    },
    {
      "src": "^/theme/(.*)",
      "dest": "/theme/$1"
    },
    {
      "src": "^/themes/(.*)",
      "dest": "/themes/$1"
    },
    {
      "src": "^/sw/(.*)",
      "dest": "/sw/$1"
    },
    {
      "src": "^/versionControl/(.*)",
      "dest": "/versionControl/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
